# ── Backend (Python / FastAPI) ──
DATABASE_URL=                              # PostgreSQL (leave blank for SQLite dev)
DATABASE_POOLED_URL=                       # Pooled URL for Neon/pgbouncer (recommended for prod)
DATABASE_REQUIRE_SSL=false                 # auto-detect on Vercel; set true for prod
SECRET_KEY=                                # JWT signing key (REQUIRED in prod: python -c "import secrets; print(secrets.token_urlsafe(32))")
FERNET_KEY=                                # Encryption for FB tokens + 2FA secrets (REQUIRED in prod: Fernet.generate_key())
CRON_SECRET=                               # Cron endpoint auth (REQUIRED in prod; used by vercel.json crons)
FACEBOOK_ACCESS_TOKEN=                     # FB Page access token
FACEBOOK_PAGE_ID=                          # FB Page ID
FB_WEBHOOK_VERIFY_TOKEN=                   # Webhook verification token (REQUIRED for /webhook GET verify)
FACEBOOK_APP_SECRET=                       # FB App secret for webhook X-Hub-Signature verification
REDIS_URL=                                 # Optional Redis (falls back to in-memory cache)
REDIS_SESSION_TTL=86400                    # Redis session TTL in seconds (default 24h)
DEBUG=false                                # true = local dev (relaxes prod env guards)
LOG_LEVEL=INFO                             # DEBUG/INFO/WARNING/ERROR
BOT_INTERVAL_SECONDS=10                    # Bot polling interval (server only)
START_BOT=true                             # Auto-start bot on app boot (server only)

# ── Payment providers (Libyan mobile wallets) ──
LIBYANA_WALLET_PHONE=                      # Libyaana wallet number for receiving payments
MADAR_WALLET_PHONE=                        # Madar wallet number for receiving payments
MOBILE_WALLET_CAP=99                      # Max amount (LYD) for mobile wallet; above this requires bank transfer

# ── Bank transfer account (shown to users in /api/config) ──
BANK_TRANSFER_BANK_NAME=                    # Bank name
BANK_TRANSFER_ACCOUNT_NUMBER=              # Account number
BANK_TRANSFER_IBAN=                       # IBAN (optional)

# ── Vercel deployment (auto-detected) ──
# VERCEL=1
# VERCEL_ENV=production
# NEON_PROJECT_ID=

# ── Telegram Admin Bot ──
TELEGRAM_BOT_TOKEN=                        # Telegram bot token for admin notifications
TELEGRAM_ADMIN_IDS=                        # Comma-separated Telegram user IDs (no spaces)
TELEGRAM_WEBHOOK_SECRET=                   # Telegram webhook secret
TELEGRAM_WEBHOOK_ALLOW_UNVERIFIED=false  # Set true ONLY for local testing
TELEGRAM_CHAT_ID=                          # Default notification chat ID

# ── AI providers (optional — falls back gracefully) ──
OPENAI_API_KEY=                            # OpenAI API key
OPENAI_BASE_URL=                           # OpenAI-compatible base URL
OPENAI_MODEL=gpt-4o-mini                   # OpenAI model name
GEMINI_API_KEY=                            # Google Gemini API key
AI_MODEL=gemini-1.5-flash                  # Default AI model

# ── Shopify commerce integration (optional) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_HMAC_SECRET=

# ── Frontend (Next.js) ──
# These go in fb_dashboard/frontend/.env.local:
# NEXT_PUBLIC_API_HOST=https://api.smart-link.ly
# NEXT_PUBLIC_DOMAIN=https://bot.smart-link.ly
# NEXT_PUBLIC_SITE_URL=https://bot.smart-link.ly
