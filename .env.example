# ── Backend (Python / FastAPI) ──
# (v10-H2: كل التعليقات في أسطر مستقلة — التعليقات المضمّنة بعد القيمة كانت تُقرأ جزءًا من القيمة)
# PostgreSQL URL — اتركها فارغة للتطوير المحلي (SQLite تلقائي)
DATABASE_URL=
# عنوان الاتصال المجمّع (Neon/pgbouncer — للإنتاج فقط)
DATABASE_POOLED_URL=
# يُكتشف تلقائيًا على Vercel؛ اجعلها true في الإنتاج
DATABASE_REQUIRE_SSL=false
# مفتاح توقيع JWT — إلزامي في الإنتاج: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# تشفير توكنات فيسبوك + أسرار 2FA — إلزامي في الإنتاج: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key())"
FERNET_KEY=
# سر نقطة cron — إلزامي في الإنتاج (تستخدمه crons في vercel.json)
CRON_SECRET=
# توكن صفحة فيسبوك (وضع المستأجر الواحد القديم — الوضع متعدد المستأجرين يخزنها لكل مستأجر)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# توكن تحقق الويبهوك (إلزامي لـ GET /webhook verify)
FB_WEBHOOK_VERIFY_TOKEN=
# سر تطبيق فيسبوك لتحقق X-Hub-Signature-256
FACEBOOK_APP_SECRET=
# Redis اختياري (بدونه: كاش في الذاكرة)
REDIS_URL=
# عمر جلسة Redis بالثواني (الافتراضي 24 ساعة)
REDIS_SESSION_TTL=86400
# true للتطوير المحلي (يخفف حراسة بيئة الإنتاج + يسمح POST المتصفح من localhost)
# اجعلها false في الإنتاج — عندها تُطلب SECRET_KEY/FERNET_KEY/CRON_SECRET فورًا
DEBUG=true
LOG_LEVEL=INFO
# فترة استقصاء البوت بالثواني (الخادم فقط)
BOT_INTERVAL_SECONDS=10
# إقلاع البوت تلقائيًا مع التطبيق (الخادم فقط)
START_BOT=true

# ── Payment providers (Libyan mobile wallets) ──
LIBYANA_WALLET_PHONE=
MADAR_WALLET_PHONE=
# الحد الأقصى (د.ل) لمحفظة الهاتف — فوقه تحويل بنكي (يُدار لاحقًا من admin config)
MOBILE_WALLET_CAP=99

# ── Bank transfer account (shown to users in /api/config) ──
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_IBAN=

# ── Vercel deployment (auto-detected) ──
# VERCEL=1
# VERCEL_ENV=production
# NEON_PROJECT_ID=

# ── Telegram Admin Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
# اجعلها true فقط للاختبار المحلي للويبهوك
TELEGRAM_WEBHOOK_ALLOW_UNVERIFIED=false
TELEGRAM_CHAT_ID=

# ── AI providers (optional — falls back gracefully) ──
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# ── Shopify commerce integration (optional) ──
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_HMAC_SECRET=

# ── Frontend (Next.js) — goes in fb_dashboard/frontend/.env.local ──
# NEXT_PUBLIC_API_HOST=https://api.smart-link.ly
# NEXT_PUBLIC_DOMAIN=https://bot.smart-link.ly
# NEXT_PUBLIC_SITE_URL=https://bot.smart-link.ly
# LOCAL_API_PROXY=http://127.0.0.1:8000   ← لتوكيل /api أثناء npm run dev (v10-H3)
