ame":"permissions-policy","value":"camera=(), microphone=(), geolocation=()"},{"name":"referrer-policy","value":"strict-origin-when-cross-origin"},{"name":"strict-transport-security","value":"max-age=31536000; includeSubDomains"},{"name":"x-content-type-options","value":"nosniff"},{"name":"x-frame-options","value":"DENY"}],"content":{"size":-1,"mimeType":"text/css; charset=UTF-8","text":"/* v9-E1 — 🔴 THE P1 font fix: globals.css declares\n   --font-sans/--font-arabic/--font-mono as `var(--font-cairo), \"Cairo\", …`.\n   A var() with NO fallback that resolves to an UNDEFINED custom property\n   makes the whole font-family declaration invalid-at-computed-value-time,\n   so the body fell back to Times New Roman in production (measured live by\n   D6 on bot.smart-link.ly). Defining the variable here — in the same\n   stylesheet that @font-face-declares \"Cairo\" — resolves every stack. */\n:root {\n  --font-cairo: \"Cairo\";\n}\n\n/* Cairo — primary UI font (variable subsets, local-first) */\n@font-face {\n  font-family: \"Cairo\";\n  font-style: normal;\n  font-weight: 400 800;\n  font-display: swap;\n  src: url(\"/fonts/cairo-arabic.woff2\") format(\"woff2\");\n  unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EE03, U+1EE05-1EE1F, U+1EE21-1EE22, U+1EE24, U+1EE27, U+1EE29-1EE32, U+1EE34-1EE37, U+1EE39, U+1EE3B, U+1EE42, U+1EE47, U+1EE49, U+1EE4B, U+1EE4D-1EE4F, U+1EE51-1EE52, U+1EE54, U+1EE57, U+1EE59, U+1EE5B, U+1EE5D, U+1EE5F, U+1EE61-1EE62, U+1EE64, U+1EE67-1EE6A, U+1EE6C-1EE72, U+1EE74-1EE77, U+1EE79-1EE7C, U+1EE7E, U+1EE80-1EE89, U+1EE8B-1EE9B, U+1EEA1-1EEA3, U+1EEA5-1EEA9, U+1EEAB-1EEBB, U+1EEF0-1EEF1;\n}\n\n@font-face {\n  font-family: \"Cairo\";\n  font-style: normal;\n  font-weight: 400 800;\n  font-display: swap;\n  src: url(\"/fonts/cairo-latin.woff2\") format(\"woff2\");\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n/* v9-E8 — REMOVED (dead weight, never requested by any page):\n   - \"Noto Sans Arabic\" (arabic + latin subsets, 197K): no selector or font\n     stack ever asks for it by name as a LOADED family — it only appears as\n     a fallback NAME in globals.css stacks (harmless: an unloaded fallback\n     is simply skipped).\n   - \"Cairo\" latin-ext subset: the app renders ar + basic latin only.\n   Kept: cairo-arabic, cairo-latin, readex-pro (both subsets),\n   noto-naskh-arabic (+latin, used by .font-naskh / Eyebrow). */\n\n/* Noto Naskh Arabic — variable (400-700) */\n@font-face {\n  font-family: \"Noto Naskh Arabic\";\n  font-style: normal;\n  font-weight: 400 700;\n  font-display: swap;\n  src: url(\"/fonts/noto-naskh-arabic.woff2\") format(\"woff2\");\n  unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EE03, U+1EE05-1EE1F, U+1EE21-1EE22, U+1EE24, U+1EE27, U+1EE29-1EE32, U+1EE34-1EE37, U+1EE39, U+1EE3B, U+1EE42, U+1EE47, U+1EE49, U+1EE4B, U+1EE4D-1EE4F, U+1EE51-1EE52, U+1EE54, U+1EE57, U+1EE59, U+1EE5B, U+1EE5D, U+1EE5F, U+1EE61-1EE62, U+1EE64, U+1EE67-1EE6A, U+1EE6C-1EE72, U+1EE74-1EE77, U+1EE79-1EE7C, U+1EE7E, U+1EE80-1EE89, U+1EE8B-1EE9B, U+1EEA1-1EEA3, U+1EEA5-1EEA9, U+1EEAB-1EEBB, U+1EEF0-1EEF1;\n}\n\n@font-face {\n  font-family: \"Noto Naskh Arabic\";\n  font-style: normal;\n  font-weight: 400 700;\n  font-display: swap;\n  src: url(\"/fonts/noto-naskh-arabic-latin.woff2\") format(\"woff2\");\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n\n/* Readex Pro — variable (300-700) */\n@font-face {\n  font-family: \"Readex Pro\";\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"/fonts/readex-pro.woff2\") format(\"woff2\");\n  unicode-range: U+0600-06FF, U+0750-077F, U+0870-088E, U+0890-0891, U+0897-08E1, U+08E3-08FF, U+200C-200E, U+2010-2011, U+204F, U+2E41, U+FB50-FDFF, U+FE70-FE74, U+FE76-FEFC, U+102E0-102FB, U+10E60-10E7E, U+10EC2-10EC4, U+10EFC-10EFF, U+1EE00-1EE03, U+1EE05-1EE1F, U+1EE21-1EE22, U+1EE24, U+1EE27, U+1EE29-1EE32, U+1EE34-1EE37, U+1EE39, U+1EE3B, U+1EE42, U+1EE47, U+1EE49, U+1EE4B, U+1EE4D-1EE4F, U+1EE51-1EE52, U+1EE54, U+1EE57, U+1EE59, U+1EE5B, U+1EE5D, U+1EE5F, U+1EE61-1EE62, U+1EE64, U+1EE67-1EE6A, U+1EE6C-1EE72, U+1EE74-1EE77, U+1EE79-1EE7C, U+1EE7E, U+1EE80-1EE89, U+1EE8B-1EE9B, U+1EEA1-1EEA3, U+1EEA5-1EEA9, U+1EEAB-1EEBB, U+1EEF0-1EEF1;\n}\n\n@font-face {\n  font-family: \"Readex Pro\";\n  font-style: normal;\n  font-weight: 300 700;\n  font-display: swap;\n  src: url(\"/fonts/readex-pro-latin.woff2\") format(\"woff2\");\n  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;\n}\n"},"headersSize":-1,"bodySize":-1,"redirectURL":""},"cache":{},"timings":{"send":-1,"wait":-1,"receive":16.035},"_frameref":"frame@665495a50f9d39e1400098d5f7ed8463","_monotonicTime":96101.674,"_resourceType":"stylesheet"},{"startedDateTime":"2026-09-07T11:50:43.654Z","time":15.568,"request":{"method":"GET","url":"http://localhost:3200/fonts/cairo-latin.woff2","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"ar-LY"},{"name":"Connection","value":"keep-alive"},{"name":"Host","value":"localhost:3200"},{"name":"Origin","value":"http://localhost:3200"},{"name":"Referer","value":"http://localhost:3200/fonts/fo