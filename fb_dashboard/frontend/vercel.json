{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.smart-link.ly/api/:path*" },
    { "source": "/webhook", "destination": "https://api.smart-link.ly/webhook" },
    { "source": "/healthz", "destination": "https://api.smart-link.ly/healthz" }
  ]
}
