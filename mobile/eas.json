{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "app": {
    "projectId": ""
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smart-link.ly"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smart-link.ly"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.smart-link.ly"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "release": {}
  }
}
